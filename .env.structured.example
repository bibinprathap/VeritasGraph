# ---- Models (any OpenAI-compatible on-prem server) ----
VG_LLM_BASE_URL=http://127.0.0.1:11434/v1
VG_LLM_MODEL=qwen2.5-coder-32b-8k
# VG_LLM_API_KEY=            # local servers need none
# VG_LLM_TIMEOUT_S=180
# VG_LLM_EXTRA_BODY={}       # JSON merged into every chat request, e.g. {"chat_template_kwargs":{"enable_thinking":false}} on vLLM

# Fast role falls back to VG_LLM_* when unset. On a 24 GB GPU keep the same model.
# VG_LLM_FAST_MODEL=llama3.1:8b

VG_EMBED_BASE_URL=http://127.0.0.1:11434/v1
VG_EMBED_MODEL=nomic-embed-text
# Prefixes default from a built-in table for known models; set to override.
# VG_EMBED_QUERY_PREFIX="search_query: "
# VG_EMBED_DOC_PREFIX="search_document: "

VG_RERANK_MODE=none          # none | rerank-api | tei | local
# VG_RERANK_BASE_URL=http://127.0.0.1:8000/v1
# VG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Refuse public model endpoints unless explicitly allowed.
# VG_LLM_ALLOW_REMOTE=1

# ---- Structured layer ----
VG_STRUCTURED_DSN=postgresql+psycopg://vg:vg@127.0.0.1:5433/vg
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VG_SECRET_KEY=
# Networks source databases may live on (loopback/private are refused otherwise).
VG_STRUCTURED_ALLOWED_NETWORKS=127.0.0.1/32,172.16.0.0/12
# SQLite/DuckDB files must live under this directory.
VG_STRUCTURED_FILE_ROOT=/srv/vg-data/files
VG_STRUCTURED_ROW_CAP=1000
VG_STRUCTURED_STATEMENT_TIMEOUT_S=30
VG_STRUCTURED_SAMPLE_ROWS=50
VG_STRUCTURED_AUTO_MIGRATE=1
VG_ASK_MIN_SIMILARITY=0.5
VG_ASK_COVERAGE=on           # on | off
